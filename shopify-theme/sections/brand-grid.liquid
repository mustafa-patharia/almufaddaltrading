{% comment %}
  Refined Brand & Partner Wordmark Grid
{% endcomment %}

<section class="brand-showcase-section">
  <div class="brand-showcase__container">
    <div class="brand-showcase__header">
      <p class="brand-showcase__meta">{{ section.settings.meta_text | default: 'Authorized Portfolios' }}</p>
      <h2 class="brand-showcase__title">{{ section.settings.heading | default: 'Global Technology Partners' }}</h2>
    </div>

    <div class="brand-showcase__grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="brand-wordmark-card" {{ block.shopify_attributes }}>
          {% if block.settings.logo_image != blank %}
            <img src="{{ block.settings.logo_image | image_url: width: 160 }}" alt="{{ block.settings.brand_name }}" width="160" height="40" loading="lazy" style="max-height: 28px; object-fit: contain;">
          {% else %}
            <span>{{ block.settings.brand_name }}</span>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Showcase",
  "settings": [
    {
      "type": "text",
      "id": "meta_text",
      "label": "Subheading",
      "default": "Authorized Portfolios"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Global Technology Partners"
    }
  ],
  "blocks": [
    {
      "type": "brand_item",
      "name": "Brand Partner",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand Name",
          "default": "Apple"
        },
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Monochrome Logo (Optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Showcase (Minimalist)",
      "blocks": [
        { "type": "brand_item", "settings": { "brand_name": "Apple" } },
        { "type": "brand_item", "settings": { "brand_name": "Samsung" } },
        { "type": "brand_item", "settings": { "brand_name": "Sony" } },
        { "type": "brand_item", "settings": { "brand_name": "Bang & Olufsen" } },
        { "type": "brand_item", "settings": { "brand_name": "Dell Technologies" } },
        { "type": "brand_item", "settings": { "brand_name": "Bose" } }
      ]
    }
  ]
}
{% endschema %}
