      "default": "100% Genuine Certified"
    },
    {
      "type": "text",
      "id": "pillar1_desc",
      "label": "Description",
      "default": "Direct authorized distributor procurement with authentic manufacturer provenance."
    },
    {
      "type": "header",
      "content": "Pillar 2"
    },
    {
      "type": "text",
      "id": "pillar2_title",
      "label": "Title",
      "default": "Corporate & Retail Sourcing"
    },
    {
      "type": "text",
      "id": "pillar2_desc",
      "label": "Description",
      "default": "Flexible commercial invoicing, tax compliance, and seamless procurement."
    },
    {
      "type": "header",
      "content": "Pillar 3"
    },
    {
      "type": "text",
      "id": "pillar3_title",
      "label": "Title",
      "default": "Express UAE Dispatch"
    },
    {
      "type": "text",
      "id": "pillar3_desc",
      "label": "Description",
      "default": "Expedited fulfillment throughout Dubai, Abu Dhabi, and Northern Emirates."
    },
    {
      "type": "header",
      "content": "Pillar 4"
    },
    {
      "type": "text",
      "id": "pillar4_title",
      "label": "Title",
      "default": "Comprehensive Warranty"
    },
    {
