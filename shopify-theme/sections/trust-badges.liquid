{% comment %}
  Value Propositions & Institutional Trust Pillars (Bespoke Hairline SVG)
{% endcomment %}

<section class="trust-pillars-section">
  <div class="trust-pillars__container">
    <div class="trust-pillars__grid">
      <!-- Pillar 1 -->
      <div class="trust-pillar-item">
        <div class="trust-pillar-item__icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="trust-pillar-item__title">{{ section.settings.pillar1_title | default: '100% Genuine Certified' }}</h3>
        <p class="trust-pillar-item__desc">{{ section.settings.pillar1_desc | default: 'Direct authorized distributor procurement with authentic manufacturer provenance.' }}</p>
      </div>

      <!-- Pillar 2 -->
      <div class="trust-pillar-item">
        <div class="trust-pillar-item__icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
        </div>
        <h3 class="trust-pillar-item__title">{{ section.settings.pillar2_title | default: 'Corporate & Retail Sourcing' }}</h3>
        <p class="trust-pillar-item__desc">{{ section.settings.pillar2_desc | default: 'Flexible commercial invoicing, tax compliance, and seamless procurement.' }}</p>
      </div>

      <!-- Pillar 3 -->
      <div class="trust-pillar-item">
        <div class="trust-pillar-item__icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3 class="trust-pillar-item__title">{{ section.settings.pillar3_title | default: 'Express UAE Dispatch' }}</h3>
        <p class="trust-pillar-item__desc">{{ section.settings.pillar3_desc | default: 'Expedited fulfillment throughout Dubai, Abu Dhabi, and Northern Emirates.' }}</p>
      </div>

      <!-- Pillar 4 -->
      <div class="trust-pillar-item">
        <div class="trust-pillar-item__icon-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <h3 class="trust-pillar-item__title">{{ section.settings.pillar4_title | default: 'Comprehensive Warranty' }}</h3>
        <p class="trust-pillar-item__desc">{{ section.settings.pillar4_desc | default: 'Complete official brand repair and replacement protection on all hardware.' }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
