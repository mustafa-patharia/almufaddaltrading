{% comment %}
  Refined Editorial Hero Section: Sophisticated & Minimalist Tech
  Al Mufaddal General Trading · Dubai, UAE
{% endcomment %}

<section class="marketplace-hero-section">
  <div class="marketplace-hero__container">
    <div class="marketplace-hero__grid">
      <!-- Main Spotlight Card -->
      <div class="marketplace-hero__main">
        <div class="marketplace-hero__badge">
          <span class="marketplace-hero__badge-dot"></span>
          {{ section.settings.badge_text | default: 'Al Mufaddal General Trading · Dubai' }}
        </div>
        
        <h1 class="marketplace-hero__title">
          {{ section.settings.heading | default: 'The New Standard in Consumer Electronics.' }}
        </h1>
        
        <p class="marketplace-hero__subtitle">
          {{ section.settings.subheading | default: 'Authorized regional distributor of premier smart devices, high-performance computing, and acoustic systems. Backed by comprehensive warranty.' }}
        </p>
        
        <div class="marketplace-hero__actions">
          <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="marketplace-hero__cta-primary">
            {{ section.settings.primary_label | default: 'Explore Catalog' }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          
          {% if section.settings.secondary_label != blank %}
            <a href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}" class="marketplace-hero__cta-secondary">
              {{ section.settings.secondary_label | default: 'Wholesale & Inquiries' }}
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Right Editorial Cards -->
      <div class="marketplace-hero__side">
        <!-- Feature Card 1 -->
        <a href="{{ section.settings.card1_link | default: routes.all_products_collection_url }}" class="marketplace-feature-card">
          <div>
            <div class="marketplace-feature-card__meta">
              <span class="marketplace-feature-card__label">{{ section.settings.card1_meta | default: 'Featured Series' }}</span>
              <span class="marketplace-feature-card__pill">{{ section.settings.card1_pill | default: 'In Stock' }}</span>
            </div>
            <h2 class="marketplace-feature-card__title">{{ section.settings.card1_title | default: 'Flagship Smartphones' }}</h2>
            <p class="marketplace-feature-card__desc">{{ section.settings.card1_desc | default: 'Curated 5G devices with certified international and GCC specifications.' }}</p>
          </div>
          <div class="marketplace-feature-card__footer">
            <span>Discover models</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Feature Card 2 -->
        <a href="{{ section.settings.card2_link | default: routes.all_products_collection_url }}" class="marketplace-feature-card">
          <div>
            <div class="marketplace-feature-card__meta">
              <span class="marketplace-feature-card__label">{{ section.settings.card2_meta | default: 'Audiophile Grade' }}</span>
              <span class="marketplace-feature-card__pill">{{ section.settings.card2_pill | default: 'New Arrival' }}</span>
            </div>
            <h2 class="marketplace-feature-card__title">{{ section.settings.card2_title | default: 'Acoustic & Studio Sound' }}</h2>
            <p class="marketplace-feature-card__desc">{{ section.settings.card2_desc | default: 'Precision wireless headphones and monitors engineered for fidelity.' }}</p>
          </div>
          <div class="marketplace-feature-card__footer">
            <span>View acoustic lineup</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

