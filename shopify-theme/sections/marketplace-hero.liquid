{% comment %}
  Marketplace Hero: Amazon & Noon hybrid layout.
  Left: Prominent Promotional Banner with Headline, Subtitle, and CTA.
  Right: Two stacked cards for "Deal of the Day" and "Featured Tech Pick".
{% endcomment %}

<section class="marketplace-hero-section">
  <div class="marketplace-hero__grid">
    <!-- Main Big Promo Banner -->
    <div class="marketplace-hero__main" style="{% if section.settings.main_bg_color != blank %}background: {{ section.settings.main_bg_color }};{% endif %}">
      {% if section.settings.main_tag != blank %}
        <span class="marketplace-hero__tag">{{ section.settings.main_tag }}</span>
      {% endif %}
      
      <h1 class="marketplace-hero__title">{{ section.settings.main_heading | default: 'Next-Gen Electronics & Smart Devices' }}</h1>
      <p class="marketplace-hero__subtitle">{{ section.settings.main_subheading | default: 'Shop the latest flagship smartphones, high-performance laptops, and audio gear with official warranty.' }}</p>
      
      <a href="{{ section.settings.main_button_link | default: '/collections/all' }}" class="marketplace-hero__cta">
        {{ section.settings.main_button_text | default: 'Shop Top Deals' }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Side Two Stacked Cards -->
    <div class="marketplace-hero__side">
      <!-- Card 1: Deal of the Day -->
      <a href="{{ section.settings.card1_link | default: '/collections/all' }}" class="marketplace-side-card marketplace-side-card--deal">
        <div>
          <span class="marketplace-side-card__badge">{{ section.settings.card1_badge | default: '⚡ Deal of the Day' }}</span>
          <h2 class="marketplace-side-card__title">{{ section.settings.card1_title | default: 'Premium ANC Headphones' }}</h2>
          <p class="marketplace-side-card__desc">{{ section.settings.card1_desc | default: 'Up to 35% OFF on top audio brands' }}</p>
        </div>
        <span class="marketplace-side-card__link">
          Explore Deals
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </a>

      <!-- Card 2: Featured Tech Pick -->
      <a href="{{ section.settings.card2_link | default: '/collections/all' }}" class="marketplace-side-card">
        <div>
          <span class="marketplace-side-card__badge">{{ section.settings.card2_badge | default: '🔥 Trending Gadget' }}</span>
          <h2 class="marketplace-side-card__title">{{ section.settings.card2_title | default: 'Smart 4K & OLED Displays' }}</h2>
          <p class="marketplace-side-card__desc">{{ section.settings.card2_desc | default: 'Crystal clear visuals for work & entertainment' }}</p>
        </div>
        <span class="marketplace-side-card__link">
          View Collection
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Marketplace Hero",
  "settings": [
    {
      "type": "header",
      "content": "Main Hero Banner"
    },
    {
      "type": "text",
      "id": "main_tag",
      "label": "Badge / Tag",
      "default": "⚡ Limited Time Electronics Offer"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Heading",
      "default": "Next-Gen Electronics & Smart Devices"
    },
    {
      "type": "textarea",
      "id": "main_subheading",
      "label": "Subheading",
      "default": "Shop the latest flagship smartphones, high-performance laptops, and audio gear with official warranty."
    },
    {
      "type": "text",
      "id": "main_button_text",
      "label": "Button Label",
      "default": "Shop Top Deals"
    },
    {
      "type": "url",
      "id": "main_button_link",
      "label": "Button Link"
    },
    {
      "type": "color_background",
      "id": "main_bg_color",
      "label": "Custom Background Gradient (Optional)"
    },
    {
      "type": "header",
      "content": "Side Card 1 (Deal of the Day)"
    },
    {
      "type": "text",
      "id": "card1_badge",
      "label": "Badge",
      "default": "⚡ Deal of the Day"
    },
    {
      "type": "text",
      "id": "card1_title",
      "label": "Title",
      "default": "Premium ANC Headphones"
    },
    {
      "type": "text",
      "id": "card1_desc",
      "label": "Description",
      "default": "Up to 35% OFF on top audio brands"
    },
    {
      "type": "url",
      "id": "card1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Side Card 2 (Trending Tech)"
    },
    {
      "type": "text",
      "id": "card2_badge",
      "label": "Badge",
      "default": "🔥 Trending Gadget"
    },
    {
      "type": "text",
      "id": "card2_title",
      "label": "Title",
      "default": "Smart 4K & OLED Displays"
    },
    {
      "type": "text",
      "id": "card2_desc",
      "label": "Description",
      "default": "Crystal clear visuals for work & entertainment"
    },
    {
      "type": "url",
      "id": "card2_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Marketplace Hero (Amazon/Noon)"
    }
  ]
}
{% endschema %}
