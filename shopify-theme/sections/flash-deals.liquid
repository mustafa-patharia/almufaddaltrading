{% comment %}
  Curated Releases & Limited Offers (Minimalist & Refined)
{% endcomment %}

<section class="curated-offers-section">
  <div class="curated-offers__container">
    <div class="curated-offers__top-bar">
      <div class="curated-offers__heading-group">
        <span class="curated-offers__meta">{{ section.settings.meta_text | default: 'Selected Procurement' }}</span>
        <h2 class="curated-offers__title">{{ section.settings.heading | default: 'Curated Hardware & Special Releases' }}</h2>
      </div>

      <div class="curated-offers__timer">
        <span>Cycle refresh in:</span>
        <span class="curated-offers__timer-val" id="curated-timer-{{ section.id }}">08:45:20</span>
      </div>
    </div>

    <div class="curated-offers__grid">
      {% assign target_collection = section.settings.collection %}
      {% if target_collection != blank and target_collection.products_count > 0 %}
        {% for product in target_collection.products limit: section.settings.products_to_show %}
          {% assign discount_pct = 0 %}
          {% if product.compare_at_price > product.price %}
            {% assign discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
          {% endif %}

          <div class="curated-card">
            <div>
              <div class="curated-card__badge-row">
                <span class="curated-card__tag">{% if discount_pct > 0 %}Save {{ discount_pct }}%{% else %}Curated{% endif %}</span>
                <span class="curated-card__shipping">Official Warranty</span>
              </div>

              <a href="{{ product.url }}" class="curated-card__image-container">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 440 }}" alt="{{ product.title | escape }}" width="440" height="440" loading="lazy">
                {% else %}
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.2"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                {% endif %}
              </a>

              <a href="{{ product.url }}" style="text-decoration: none;">
                <h3 class="curated-card__title">{{ product.title }}</h3>
              </a>

              <div class="curated-card__pricing">
                <span class="curated-card__price-active">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="curated-card__price-original">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>

            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="curated-card__action-btn" {% unless product.available %}disabled style="opacity: 0.5;"{% endunless %}>
                {% if product.available %}
                  <span>Add to Procurement</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                {% else %}
                  Sold Out
                {% endif %}
              </button>
            </form>
          </div>
        {% endfor %}
      {% else %}
        <!-- Demonstration curated cards for initial presentation -->
        {% assign items = "Ultra-Slim Titanium 5G Smartphone (256GB),Studio Acoustic Noise-Cancelling Headphones,Pro Edition Laptop 14-inch (32GB Unified Memory),Titanium Smartwatch with Sapphire Crystal" | split: "," %}
        {% assign prices = "AED 3,799,AED 1,249,AED 6,899,AED 1,499" | split: "," %}
        {% assign compares = "AED 4,299,AED 1,499,AED 7,499,AED 1,799" | split: "," %}
        {% assign savings = "Save 12%,Save 16%,Save 8%,Save 17%" | split: "," %}

        {% for item in items %}
          <div class="curated-card">
            <div>
              <div class="curated-card__badge-row">
                <span class="curated-card__tag">{{ savings[forloop.index0] }}</span>
                <span class="curated-card__shipping">UAE Express</span>
              </div>

              <div class="curated-card__image-container">
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.2"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>

              <h3 class="curated-card__title">{{ item }}</h3>

              <div class="curated-card__pricing">
                <span class="curated-card__price-active">{{ prices[forloop.index0] }}</span>
                <span class="curated-card__price-original">{{ compares[forloop.index0] }}</span>
              </div>
            </div>

            <a href="{{ routes.all_products_collection_url }}" class="curated-card__action-btn">
              <span>View Specifications</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function initCuratedTimer() {
    const el = document.getElementById('curated-timer-{{ section.id }}');
    if (!el) return;
    let sec = 31520;
    setInterval(function() {
      if (sec <= 0) sec = 86400;
      sec--;
      const h = String(Math.floor(sec / 3600)).padStart(2, '0');
      const m = String(Math.floor((sec % 3600) / 60)).padStart(2, '0');
      const s = String(sec % 60).padStart(2, '0');
      el.textContent = h + ':' + m + ':' + s;
    }, 1000);
  })();
</script>

{% schema %}
{
  "name": "Curated Hardware",
  "settings": [
    {
      "type": "text",
      "id": "meta_text",
      "label": "Top Category Tag",
      "default": "Selected Procurement"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Curated Hardware & Special Releases"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Curated Hardware (Sophisticated)"
    }
  ]
}
{% endschema %}
