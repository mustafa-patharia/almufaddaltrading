{% comment %}
  Flash Deals with Live Countdown Timer (Amazon & Noon signature).
  Pulls products from a selected collection, with live urgency timer,
  discount badges, stock scarcity progress bar, and instant Add-to-Cart.
{% endcomment %}

<section class="flash-deals-section">
  <div class="flash-deals__container">
    <!-- Header Banner with Live Countdown Timer -->
    <div class="flash-deals__banner">
      <div class="flash-deals__title-wrap">
        <span class="flash-deals__badge">{{ section.settings.badge_text | default: '⚡ Flash Deals' }}</span>
        <h2 class="flash-deals__title">{{ section.settings.heading | default: 'Deals of the Day' }}</h2>
      </div>

      <div class="flash-deals__timer" id="flash-deals-timer-{{ section.id }}" data-hours="{{ section.settings.countdown_hours | default: 9 }}">
        <span>Ends in:</span>
        <span class="flash-deals__timer-digit" id="timer-hours-{{ section.id }}">08</span> :
        <span class="flash-deals__timer-digit" id="timer-mins-{{ section.id }}">45</span> :
        <span class="flash-deals__timer-digit" id="timer-secs-{{ section.id }}">20</span>
      </div>
    </div>

    <!-- Product Deals Grid -->
    <div class="flash-deals__grid">
      {% assign target_collection = section.settings.collection %}
      {% if target_collection != blank and target_collection.products_count > 0 %}
        {% for product in target_collection.products limit: section.settings.products_to_show %}
          {% assign discount_pct = 0 %}
          {% if product.compare_at_price > product.price %}
            {% assign discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
          {% endif %}

          <div class="deal-card">
            <div>
              <div class="deal-card__badge-row">
                <span class="deal-card__discount">{% if discount_pct > 0 %}-{{ discount_pct }}%{% else %}DEAL{% endif %}</span>
                <span class="deal-card__express">⚡ Express</span>
              </div>

              <a href="{{ product.url }}" class="deal-card__image-wrap">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" width="400" height="400" loading="lazy">
                {% else %}
                  <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                {% endif %}
              </a>

              <a href="{{ product.url }}" style="text-decoration: none;">
                <h3 class="deal-card__title">{{ product.title }}</h3>
              </a>

              <div class="deal-card__pricing">
                <span class="deal-card__price-sale">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="deal-card__price-compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>

              <div class="deal-card__progress-wrap">
                <div class="deal-card__progress-bar">
                  <div class="deal-card__progress-fill" style="width: {{ 65 | plus: forloop.index | times: 3 | modulo: 30 | plus: 65 }}%;"></div>
                </div>
                <span class="deal-card__stock-text">🔥 Limited stock remaining</span>
              </div>
            </div>

            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="deal-card__button" {% unless product.available %}disabled style="opacity: 0.6;"{% endunless %}>
                {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
              </button>
            </form>
          </div>
        {% endfor %}
      {% else %}
        <!-- Demonstration Cards if store has no products assigned yet -->
        {% assign demo_items = "Flagship 5G Smartphone 256GB,Active Noise Cancelling Wireless Headphones,Ultra-Slim 14-inch Laptop (16GB RAM),Waterproof Smartwatch with AMOLED Display" | split: "," %}
        {% assign demo_prices = "AED 2,899,AED 649,AED 3,499,AED 429" | split: "," %}
        {% assign demo_compares = "AED 3,499,AED 899,AED 4,199,AED 599" | split: "," %}
        {% assign demo_discounts = "-17%,-28%,-16%,-28%" | split: "," %}

        {% for item in demo_items %}
          <div class="deal-card">
            <div>
              <div class="deal-card__badge-row">
                <span class="deal-card__discount">{{ demo_discounts[forloop.index0] }}</span>
                <span class="deal-card__express">⚡ Express Delivery</span>
              </div>

              <div class="deal-card__image-wrap">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>

              <h3 class="deal-card__title">{{ item }}</h3>

              <div class="deal-card__pricing">
                <span class="deal-card__price-sale">{{ demo_prices[forloop.index0] }}</span>
                <span class="deal-card__price-compare">{{ demo_compares[forloop.index0] }}</span>
              </div>

              <div class="deal-card__progress-wrap">
                <div class="deal-card__progress-bar">
                  <div class="deal-card__progress-fill" style="width: {{ 70 | plus: forloop.index | times: 5 | modulo: 25 | plus: 70 }}%;"></div>
                </div>
                <span class="deal-card__stock-text">🔥 Only {{ 2 | plus: forloop.index }} left in stock!</span>
              </div>
            </div>

            <a href="{{ routes.all_products_collection_url }}" class="deal-card__button">
              View Deal
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function initFlashCountdown() {
    const hoursEl = document.getElementById('timer-hours-{{ section.id }}');
    const minsEl = document.getElementById('timer-mins-{{ section.id }}');
    const secsEl = document.getElementById('timer-secs-{{ section.id }}');
    if (!hoursEl || !minsEl || !secsEl) return;

    let totalSeconds = (parseInt({{ section.settings.countdown_hours | default: 9 }}) * 3600) + (45 * 60) + 20;

    function updateTimer() {
      if (totalSeconds <= 0) {
        totalSeconds = 12 * 3600; // Loop back
      }
      const h = Math.floor(totalSeconds / 3600);
      const m = Math.floor((totalSeconds % 3600) / 60);
      const s = totalSeconds % 60;

      hoursEl.textContent = String(h).padStart(2, '0');
      minsEl.textContent = String(m).padStart(2, '0');
      secsEl.textContent = String(s).padStart(2, '0');

      totalSeconds--;
    }

    setInterval(updateTimer, 1000);
    updateTimer();
  })();
</script>

{% schema %}
{
  "name": "Flash Deals & Urgency",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Label",
      "default": "⚡ FLASH DEALS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Deals of the Day"
    },
    {
      "type": "range",
      "id": "countdown_hours",
      "label": "Countdown Timer Starting Hours",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum Products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Flash Deals (Countdown & Urgency)"
    }
  ]
}
{% endschema %}
