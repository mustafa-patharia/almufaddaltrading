{% doc %}
  Outputs CSS variables for Al Mufaddal General Trading marketplace styling.
  All colors are linked directly to Theme Settings so the client can change them anytime
  from Shopify Admin > Online Store > Customize > Theme Settings > Electronics & Marketplace.
{% enddoc %}

<style>
  :root {
    /* Marketplace Theme Colors (Fully customizable via Theme Settings) */
    --tech-header-bg: {{ settings.marketplace_header_bg | default: '#0f172a' }};
    --tech-header-text: {{ settings.marketplace_header_text | default: '#ffffff' }};
    --tech-accent: {{ settings.marketplace_accent_color | default: '#0284c7' }};
    --tech-accent-hover: {{ settings.marketplace_accent_color | default: '#0284c7' | color_darken: 10 }};
    --tech-deal-badge: {{ settings.marketplace_deal_badge | default: '#e11d48' }};
    --tech-gold: {{ settings.marketplace_secondary_accent | default: '#f59e0b' }};
    --tech-card-bg: {{ settings.marketplace_card_bg | default: '#ffffff' }};
    --tech-card-border: {{ settings.marketplace_card_border | default: '#e2e8f0' }};
    --tech-body-bg: {{ settings.page_background_color | default: '#ffffff' }};
    --tech-text-main: {{ settings.page_text_color | default: '#0f172a' }};
    --tech-text-muted: #64748b;
    --tech-pill-bg: #f1f5f9;
    --tech-shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.06);
    --tech-shadow-md: 0 4px 14px rgba(15, 23, 42, 0.08);
    --tech-shadow-lg: 0 10px 25px rgba(15, 23, 42, 0.12);
    --tech-radius: 8px;
    --tech-radius-lg: 12px;
    --tech-font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
</style>
